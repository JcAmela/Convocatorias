---
import Base from '../layouts/Base.astro';
import { Tablero } from '../components/Tablero';
import { datosPublicos, paraCalendario, primeras, sitiosDe } from '../lib/publicos';
import { jsonLdPortada } from '../lib/seo';

// El HTML solo lleva lo que se ve al abrir: el resumen, las primeras 24
// abiertas con sus sitios y lo mínimo para el calendario. El resto lo pide la
// isla a `/datos/` cuando le hace falta. Si los datos no son publicables, el
// build falla y sigue servida la versión anterior (`lectura.ts`).
const { tablero } = await datosPublicos();
const visibles = primeras(tablero.abiertas);
const inicial = {
  ...tablero,
  abiertas: visibles,
  pendientes: [],
  cerradas: [],
  sitios: sitiosDe(visibles, tablero.sitios),
};
const parcial = { calendario: paraCalendario(tablero.abiertas, tablero.hoy) };
---

<Base
  titulo="Convocatorias — empleo público en Cataluña"
  descripcion="Empleo público con el plazo abierto en toda Cataluña: ayuntamientos, consejos comarcales, Generalitat y diputaciones. Filtra por municipio, estudios y plazo."
  jsonld={jsonLdPortada()}
>
  <Tablero inicial={inicial} parcial={parcial} client:load />
</Base>
