---
import Base from '../layouts/Base.astro';
import { Tablero } from '../components/Tablero';
import { leeTablero, soloLoVisible } from '../lib/datos';

// Se lee en el build para que la primera pintada ya lleve plazas de verdad.
// El navegador vuelve a pedirlo al montar la isla, así que lo que se ve
// acaba siendo lo de hoy aunque el despliegue sea de la semana pasada.
const datos = soloLoVisible(await leeTablero());
---

<Base
  titulo="Convocatorias — empleo público en Cataluña"
  descripcion="Plazas de empleo público con el plazo abierto en toda Cataluña: ayuntamientos de las cuatro provincias, consejos comarcales, Generalitat y diputaciones. Filtra por municipio, comarca, distancia desde tu pueblo, estudios y días que quedan."
>
  <Tablero inicial={datos} client:load />
</Base>
