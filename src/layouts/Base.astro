---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;

// `Astro.site` viene de astro.config.mjs; si no estuviera, se cae con elegancia
// a la URL con la que se ha pedido la página.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonica} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Convocatorias" />
    <meta name="twitter:card" content="summary" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {/* El tema elegido se aplica antes de pintar: sin esto, quien tiene el
        modo oscuro guardado vería un fogonazo blanco en cada carga. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('convocatorias:tema');
        if (t === 'oscuro') document.documentElement.setAttribute('data-theme', 'dark');
        if (t === 'claro') document.documentElement.setAttribute('data-theme', 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="bg-pine sr-only rounded-br-lg px-4 py-2 text-base font-semibold text-white focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50"
    >
      Saltar a los resultados
    </a>
    <slot />
  </body>
</html>
