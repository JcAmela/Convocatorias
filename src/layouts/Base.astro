---
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Páginas que no deben salir en los buscadores: el perfil, la 404. */
  noindex?: boolean;
}

const { titulo, descripcion, noindex = false } = Astro.props;

// `Astro.site` viene de astro.config.mjs; si no estuviera, se cae con elegancia
// a la URL con la que se ha pedido la página.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonica} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Convocatorias" />
    <meta name="twitter:card" content="summary" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    {/* Sin webfonts: la letra es la del sistema (global.css). Las tres de
        Google retrasaban el primer pintado de cada visita. */}
    <meta name="theme-color" content="#f3f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1112" media="(prefers-color-scheme: dark)" />

    {/* El tema elegido se aplica antes de pintar: sin esto, quien tiene el
        modo oscuro guardado vería un fogonazo blanco en cada carga. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('convocatorias:tema');
        if (t === 'oscuro') document.documentElement.setAttribute('data-theme', 'dark');
        if (t === 'claro') document.documentElement.setAttribute('data-theme', 'light');
      } catch {}
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="bg-pine sr-only rounded-br-md px-4 py-2 text-base font-semibold text-on-pine focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50"
    >
      Saltar a los resultados
    </a>
    <slot />
  </body>
</html>
